{
  "name": "@johnhenry/dataflow",
  "version": "0.0.2",
  "description": "An async dataflow scheduler: nodes that depend on other nodes, run by your async function, with glitch-free propagation, stale-run cancellation, skip values and per-node run states. Values live wherever you keep them.",
  "type": "module",
  "main": "src/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/ && npm run examples",
    "examples": "for f in examples/[0-9]*.mjs; do node \"$f\" || exit 1; done",
    "example:01": "node examples/01-a-spreadsheet-recomputes-only-what-changed.mjs",
    "example:02": "node examples/02-a-slow-stale-run-never-overwrites-a-newer-one.mjs",
    "example:03": "node examples/03-errors-make-dependents-wait-not-fail.mjs",
    "example:04": "node examples/04-skip-values.mjs",
    "example:05": "node examples/05-partial-runs-and-unchanged.mjs"
  },
  "keywords": [
    "dataflow",
    "reactive",
    "scheduler",
    "spreadsheet",
    "notebook",
    "async",
    "dependency-graph",
    "cancellation",
    "control-flow"
  ],
  "author": "John Henry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/dataflow.git"
  },
  "homepage": "https://opensource.johnhenry.me/dataflow/",
  "bugs": "https://github.com/johnhenry/dataflow/issues",
  "engines": {
    "node": ">=26.0.0"
  }
}
